{
  // 配置结构版本，供自动迁移判断，不要手工改
  "version": "2.12",
  // 时序判定参数。单位：时间=秒，距离=按画面对角线归一化
  "pipeline": {
    // 检测最大帧率。也是帧率自适应的基准：实际帧间隔超过 1/max_fps 时，距离门限按倍率放大（见 frame_scale_max）
    "max_fps": 20,
    // 手-丝杆关联时视为「够得着」的最大归一化中心距离
    "pick_hand_distance": 0.05,
    // 手在涂油盘内的最短停留时长。低于该值视为从盘边划过，不判取料。纯时间阈值，不随帧率缩放
    "pick_confirm_s": 0.3,
    // 取料判定的采样间隔（帧）：每隔这么多帧记一次「是否在盘内 / 手里是否有杆」的状态
    "pick_sample_every_frames": 2,
    // 取料判定保留的采样点数：用最近这么多个采样点投票，避免单帧抖动导致漏判或误判。
    // 与上一项相乘决定离盘后攒够多少个盘外采样才定论（= 发取料事件的延迟）
    "pick_history_samples": 3,
    // 第二条取料判据：丝杆本身从盘区内移到盘区外也算取料，不依赖手部跟踪。
    // 与「空手进盘→带料离盘」并行判定，两条同时判出时按去重窗口只报一次
    "screw_exit_pick_enabled": true,
    // 丝杆轨迹的关联距离（第二条取料判据用）。杆比手小、位移也小，门限要取得比手紧，否则轨迹会在盘里那排杆之间跳
    "screw_exit_track_distance": 0.06,
    // 丝杆轨迹漏检后保留时长。杆被手完全遮住一两秒是常态，太短会把一次取料切成两段
    "screw_exit_track_missing_s": 1.0,
    // 丝杆必须在盘区内被连续观测这么久才算「确实在盘里」。低于该值视为从盘边划过或检测框抖动跨边线，不判取料。纯时间阈值，不随帧率缩放
    "screw_exit_pick_inside_s": 0.3,
    // 丝杆中心越过盘区边线这么多（按画面对角线归一化）才算「出盘」，防止贴着边线抖动就判取料
    "screw_exit_pick_margin": 0.01,
    // 两条取料判据的去重窗口：同一件料两条几乎同时确认，窗口内只报一次。不能放大到几秒，否则会把紧接的下一件真取料吞掉
    "screw_exit_pick_dedup_s": 1.0,
    // 手部轨迹匹配的最大归一化中心距离。低帧率时按帧间隔自动放大
    "hand_track_max_distance": 0.15,
    // 手部轨迹漏检后保留时长，超过即删除轨迹
    "hand_track_max_missing_s": 0.8,
    // 手部轨迹需命中多少帧才参与刷头靠近判定
    "hand_track_min_hits": 1,
    // 同时保留的手部轨迹上限。漏检轨迹在保留期内仍占名额，设小了会让新的手检测框建不了轨迹（画面里常有手臂、盘边被误检成 hand）
    "hand_track_max_active": 8,
    // 刷头轨迹匹配的最大归一化中心距离
    "brush_track_max_distance": 0.15,
    // 刷头轨迹漏检后保留时长
    "brush_track_max_missing_s": 1.5,
    // 刷头轨迹需命中多少帧才参与靠近判定
    "brush_track_min_hits": 1,
    // 同时保留的刷头轨迹上限
    "brush_track_max_active": 3,
    // 刷头轨迹的出生准入距离：刷头检测离任一 hand/screw 检测中心都超过
    // 该值时不新建轨迹（已有轨迹照常延续）。刷子干活时必然在手边，远离手
    // 与丝杆的「刷头」多是白色物件误检。0 = 关闭（默认）
    "brush_spawn_max_distance": 0.0,
    // 刷头工作点到手持丝杆杆身中线（沿杆方向的偏移不计）的归一化距离小于该值，本帧计为「靠近」
    "brush_contact_distance": 0.06,
    // 刷头靠近累计到该时长即判「人工二次涂油完成」。纯时间阈值，不随帧率缩放
    "brush_hold_s": 1.0,
    // 取料后超过该时长仍未完成二次涂油即判漏涂 NG，不等下一次取料；0=不限时。按媒体时间累计，掉帧不暂停
    "oiling_timeout_s": 5.0,
    // 手部轨迹消失后，进盘过程作废的时长（取料判定用）
    "holding_lost_timeout_s": 2.0,
    // 预留项：当前判定逻辑本身就只维护一个活动周期，改这里不会变成多任务
    "single_active_task": true,
    // 内存中最多保留多少个作业周期
    "task_max_active": 4,
    // 已结束（完成/NG）的周期保留最近多少条，供监控页任务卡片显示
    "completed_keep_count": 4,
    // 已结束周期最多再保留这么久即回收（与上一项取交集）；0=不限时
    "completed_retain_s": 3600.0,
    // 手框与丝杆框的关联距离上限；还要求两者交叠才认作「握着」
    "hand_screw_max_distance": 0.1,
    // 预留项：当前判定未使用，手-丝杆关联直接按交叠与距离判定
    "hand_interaction_margin": 0.02,
    // 预留项：丝杆锚点跟踪上线后不再使用（锚点按位置连续性跟随）
    "held_infer_distance": 0.1,
    // 手/丝杆短时遮挡时按预测位置继续的时长。按帧率自动放大
    "held_predict_hold_s": 0.5,
    // 丝杆锚点单帧最大位移。取料后按最近邻连续性跟这根杆，既跟得住快速移动，又不会跳到相邻丝杆（盘里间距很小）
    "screw_anchor_max_step": 0.12,
    // 锚点单帧位移的绝对上限，不随帧率放大。用于低帧率下防止锚点跳到相邻丝杆；
    // 必须不小于 screw_anchor_max_step（取料瞬间手带杆打出画面，单帧位移可达 0.11）
    "screw_anchor_max_step_abs": 0.15,
    // 锚点当帧找不到时，按锚点位置继续跟踪的时长；超出则在下面时限内尝试重新捕获
    "screw_anchor_hold_s": 0.5,
    // 刷头整帧漏检时允许补回的最大空档。用于低帧率下不丢时间；刷子检测到了但离得远不补
    "brush_hold_max_gap_s": 0.5,
    // 同一件刷够时长后继续刷多久内不再算新的一次涂油。刷够并不会立刻撒手，一件常连续刷 3~6 秒；按帧率放大
    "oiling_holdoff_s": 2.5,
    // 手持丝杆离开画面后允许重新捕获的时长。工人取完料可能拿着杆走出画面、
    // 过一会儿再回来涂油，这段时间内周期保持已取料并继续等；0=不限时
    "screw_reacquire_timeout_s": 0.0,
    // 帧率自适应倍率上限。门限按「实际帧间隔 / (1/max_fps)」放大，但不超过该值，避免低帧率时门限大到失去区分度
    "frame_scale_max": 4.0,
    // 已跟踪目标移出工作追踪区后继续跟踪的距离余量。区外目标不会新建轨迹
    "roi_track_margin": 0.2,
    // auto=优先 ByteTrack，失败回退自研；可选 bytetrack / object
    "hand_tracker_backend": "bytetrack",
    // 同上，刷头专用
    "brush_tracker_backend": "bytetrack",
    // ByteTrack 高置信度检测阈值（第一阶段关联）。低分刷头框里混着白毛巾/
    // 白导轨误检，0.30 会喂进第一阶段并长成轨迹，实测 0.45 更稳
    "bytetrack_high_thresh": 0.45,
    // ByteTrack 低置信度检测阈值（第二阶段补救关联）
    "bytetrack_low_thresh": 0.1,
    // 达到该置信度才允许新建轨迹
    "bytetrack_new_thresh": 0.3,
    // 关联代价阈值。未进门限的代价固定为 1.5，所以 1.0 表示「只看距离/IoU 门限」；
    // 调小可加严（现场标定用）
    "bytetrack_match_thresh": 1.0,
    // ByteTrack 内部轨迹缓冲区（按 max_fps 换算成帧数）。不决定轨迹寿命——适配器在 *_track_max_missing_s 到点即退役并剔除，想延长寿命调那一项
    "bytetrack_buffer_s": 3.0,
    // 关联代价权重：α·(1-IoU) + (1-α)·(中心距离/上限)。调大更看重框重叠，调小更看重中心距离
    "bytetrack_cost_alpha": 0.4
  },
  // 训练视频录制参数
  "recording": {
    // 录制输出目录，相对数据目录解析
    "training_dir": "recordings/training",
    // 录制帧率
    "fps": 15,
    // 单个分段视频的时长，超过即切新文件
    "segment_seconds": 300.0,
    // OpenCV VideoWriter 编码，例如 mp4v / XVID
    "codec": "mp4v",
    // 启动后是否自动开始录制
    "auto_start": false,
    // 保存 NG 事件前后的画面片段（复核页可直接播放）。默认关闭：片段写盘
    // 与训练录制抢同一块盘与编码资源，现场确认硬盘余量后再打开
    "event_clips_enabled": false,
    // 片段目录，相对数据目录解析
    "clip_dir": "clips",
    // 环形缓冲长度（秒）。只作保险，覆盖判定结算的抖动；事件要回看的起点
    // 从事件里取（取料时刻），不靠这个长度
    "clip_pre_seconds": 3.0,
    // 事件自带的起止之外前后各再延长多久（秒）。事件起止是判定口径，比人手
    // 看到的完整动作窄；留 1.5 秒余量才能看清取料前伸手、判出后放下件的全过程
    "clip_margin_seconds": 1.5,
    // 事件之后再额外录多久。判出 NG 后留 2 秒，看清工人随后的处理动作
    "clip_post_seconds": 2.0,
    // 片段缓冲的缩放宽，0 = 不缩放。缓冲存的是 JPEG：原生 2560×1440 约
    // 11ms/帧、8 秒约 265MB；720p 约 2ms/45MB
    "clip_buffer_width": 0,
    // 片段缓冲的 JPEG 质量（1~100），默认 75
    "clip_jpeg_quality": 75,
    // 环形缓冲内存上限（MB）。超过就丢最旧的帧并记 warning
    "clip_buffer_max_mb": 512,
    // 片段帧率；0 = 跟随 fps。片段比训练录制更需要动作完整，不建议低于 10
    "clip_fps": 0,
    // 片段编码 FourCC；空 = 跟随 codec
    "clip_codec": "",
    // 每相机同时挂起的片段上限。超限时提前收尾最早的
    "clip_max_pending": 2,
    // 启动时清理超过该天数的片段；0 = 不清理
    "clip_retain_days": 30
  },
  // 示例视频回放（画面来自 mp4，检测仍由模型完成）
  "demo": {
    // 播放结束后是否从头循环
    "loop": true,
    // 投放帧率上限，实际取 min(视频原帧率, 该值)。与 pipeline.max_fps 取同一个数，回放才不会凭空丢帧
    "fps_limit": 20,
    // 播放速率倍数（0.1~4）。只改播放快慢，判定按视频媒体时间计时，结果不受影响
    "speed": 1.0,
    // 示例视频目录（相对仓库根或绝对路径）。程序自动扫描这里的录像放进「画面源」下拉，新录像拷进来即可出现，无需改配置
    "sample_dir": "data/sample_video"
  },
  // PLC 警示灯（Modbus TCP）。默认关闭且只读：装上代码不会自动写 PLC。协议见 docs/12-PLC警示灯通信与控制.md
  "plc": {
    // 总开关。默认关闭：装上代码不会自动连/写 PLC；现场确认字节序与工步编号后再打开（见 docs/12 §1.2）
    "enabled": true,
    // 只读联调：照常算帧、照常打日志，但不写 PLC
    "dry_run": false,
    // PLC 的 IP。本机需在 192.168.1.x 网段（见 docs/12 §1.2）
    "host": "192.168.1.88",
    // Modbus TCP 端口，现场协议表为 502
    "port": 502,
    // 从站 unit id。该 PLC 不校验（实测 0/1/2/255 都接受）
    "unit_id": 1,
    // 保持寄存器首地址。现场协议表从 0 开始（不是 40001）
    "register_base": 0,
    // 取哪个工位的判定状态；留空 = 第一个启用的工位
    "station_id": "",
    // 一拍周期。PLC 空闲 10~18s 会断连，且只允许一条 Modbus 会话，这里同时起保活作用
    "poll_interval_ms": 200,
    // 期望值没变也按这个周期重写一次，用于 PLC 重启后自愈（实测上电残留值 HR1=0x00FF）
    "refresh_interval_s": 1.0,
    // 建连超时
    "connect_timeout_s": 1.0,
    // 单次请求超时。超时一律当断链处理并重连
    "request_timeout_s": 0.5,
    // 断链重连退避（毫秒）。实测同一时刻连发第二条建连要等约 1s，不能 0ms 猛重试
    "reconnect_backoff_ms": [200, 500, 1000, 2000, 5000],
    // 涂油完成/异常（良品三绿、漏涂红灯）在 PLC 上保持多久再回等待取料。现场要求灯4 亮 2 秒，默认 2.0
    "hold_s": 2.0,
    // 灯位编号。位 = 灯号（bit(n-1) → 第 n 盏）。pick 取料、oiling 涂油结论、result 上一件检测结果；默认 2 / 4 / 5，要求 1<=pick<=3、oiling=pick+2 且 <=4（进度灯只占前 4 盏）、result=0 或 oiling<result<=8
    "steps": {
      // 取料记在第几盏灯（1~3，灯1 只能红；oiling 必须 = pick+2）
      "pick": 2,
      // 涂油结论记在第几盏灯（= pick+2，<=4）
      "oiling": 4,
      // 上一件检测结果记在第几盏灯（默认 5，必须 > oiling；0 = 不显示）。切换结论时先闪 0.3 秒黄，再常亮（良品绿、漏涂红）到下一个结论到来
      "result": 5
    }
  },
  // 工位列表，每个工位一台相机
  "stations": [
    {
      // 工位 ID，事件与日志里用它区分
      "station_id": "ST01",
      // 工位显示名
      "name": "1号取料工位",
      // 对应 cameras.json 里的相机 ID
      "camera_id": "cam_6ca47a",
      // 是否启用该工位
      "enabled": true,
      // 涂油盘区，用于判断「手进盘/离盘」。必须把盘体连同下方手臂活动范围一起框进去：模型只框得出盘体本身，手取料时在盘体下方 100~280px。盘区只由这个手工区决定，模型检出的 oil_station 框不参与判定
      "tray_roi": {
        // 区域类型，目前只支持 rect
        "kind": "rect",
        // 归一化坐标 0~1：左上角、右下角两个点
        "points": [
          [0.522651, 0.090604],
          [0.667995, 0.397651]
        ]
      },
      // 工作追踪区，跟踪与判定的有效范围。只有中心落在该区（或涂油盘区）内的目标才新建轨迹
      "work_roi": {
        // 区域类型，目前只支持 rect
        "kind": "rect",
        // 归一化坐标 0~1：左上角、右下角两个点
        "points": [
          [0.354077, 0.001712],
          [0.893461, 0.996575]
        ]
      },
      // 涂油区，标定与显示用，本轮不参与判定，预留给后续涂油范围约束
      "oiling_roi": {
        // 区域类型，目前只支持 rect
        "kind": "rect",
        // 归一化坐标 0~1：左上角、右下角两个点
        "points": [
          [0.353114, 0.398973],
          [0.894424, 1.0]
        ]
      },
      // 检测模型与类别名
      "detector": {
        // null=不检出（框架自检）；yolo=用 Ultralytics 权重
        "kind": "yolo",
        // 权重路径，相对仓库根或绝对路径
        "model_path": "model/detect/exp/weights/best.pt",
        // 检测置信度阈值。要低于 bytetrack_high_thresh（0.3），否则低于该值的框
        // 在检测层就被丢掉，ByteTrack 的低分补救关联（第二阶段）永远收不到输入
        "confidence": 0.25,
        // NMS 的 IoU 阈值
        "iou": 0.7,
        // 单帧最多输出多少个检测框
        "max_det": 100,
        // 推理输入尺寸。0=自适应：优先用权重里训练时的尺寸，取不到回退 640
        "imgsz": 0,
        // auto/空=有 CUDA 用 cuda:0；也可显式 cpu / cuda:0 / 0
        "device": "auto",
        // 是否用 FP16 推理（只在 CUDA 上生效）
        "half": false,
        // 旁路排查模式：只交出全量检测结果，不建轨迹、不判定、不产生事件
        "raw_mode": false,
        // 模型输出的丝杆类别名
        "screw_label": "screw",
        // 模型输出的手部类别名
        "hand_label": "hand",
        // 模型输出的刷具类别名
        "brush_label": "brush",
        // 模型输出的涂油盘类别名
        "tray_label": "oil_station",
        // 刷子没有关键点时，用框内相对坐标（0~1）估计工作端：横向位置
        "brush_point_offset_x": 0.5,
        // 刷子没有关键点时，用框内相对坐标（0~1）估计工作端：纵向位置
        "brush_point_offset_y": 0.9
      }
    }
  ]
}
